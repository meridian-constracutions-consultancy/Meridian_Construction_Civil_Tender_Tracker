# ==============================================================================
# CivilTender India - Environment Configuration Template
# NOTE: Copy this file to '.env' and fill in your actual private secrets.
# NEVER commit your actual '.env' file to version control or Git repositories.
# ==============================================================================

# Application Environment Configuration
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (Defaults to zero-cost local SQLite database)
DATABASE_URL=sqlite:///./tender_intelligence.db
# Optional PostgreSQL URL for high-concurrency production:
# DATABASE_URL=postgresql://db_user:strong_password@localhost:5432/tender_db

# Security Credentials & Cryptographic Keys (CHANGE THESE IN YOUR PRIVATE .env)
JWT_SECRET_KEY=replace_with_a_64_character_random_hex_or_secret_string_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Initial Administrator Account (Initialized on first startup)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeThisPasswordToAStrongSecret!2026

# Defense-Grade WAF & Rate Limiting Defense
RATE_LIMIT_ENABLED=true
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Portal Discovery & Network Settings
POLL_INTERVAL_MINUTES=10
MAX_CONCURRENT_COLLECTIONS=2
REQUEST_TIMEOUT_SECONDS=30
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"

# Security Allowlist & CORS Policy
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
ALLOWED_SOURCE_HOSTS=["eproc.rajasthan.gov.in","eprocure.gov.in"]

# Document Processing & OCR
ENABLE_OCR=true
TESSERACT_CMD=
